[Unit]
Description=Character RVC Singing Gateway
After=network-online.target
Wants=network-online.target

[Service]
User=ahuai
WorkingDirectory=/www/ahuai/rvc-singing
EnvironmentFile=/www/ahuai/rvc-singing-data/gateway.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/www/ahuai/rvc-singing-runtime/bin/python -B -m uvicorn gateway.app:create_app --factory --host 127.0.0.1 --port 9002
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
